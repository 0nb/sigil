{
  "name": "@0nb/sigil",
  "version": "0.5.0",
  "description": "the 0nb design system",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "src/lib"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/lib/index.d.ts",
      "svelte": "./src/lib/index.js",
      "default": "./src/lib/index.js"
    },
    "./theme.css": "./src/lib/theme.css",
    "./tokens.css": "./src/lib/tokens.css",
    "./pages.css": "./src/lib/pages.css",
    "./horizon": {
      "types": "./src/lib/horizon/horizon.d.ts",
      "default": "./src/lib/horizon/horizon.js"
    }
  },
  "peerDependencies": {
    "svelte": "^5",
    "tailwindcss": "^4"
  },
  "scripts": {
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./jsconfig.json",
    "format": "prettier --write .",
    "dev": "vite",
    "brand": "node scripts/brand.js",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.2"
}
