{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["svelte", "vitest/globals", "@testing-library/jest-dom"]
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "playground/**/*"]
}
