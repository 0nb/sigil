{
  "compilerOptions": {
    "checkJs": true,
    "allowJs": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "esnext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "svelte",
      "node",
      "vite/client"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "playground/**/*"
  ]
}
